# 复制为 env/.env.local，填写自己的应用 ID（该本地文件不提交）
VITE_WX_APPID = 'touristappid'
VITE_UNI_APPID = ''

# 开发接口地址在 env/.env.development.local 覆盖；生产地址在
# env/.env.production.local 覆盖。微信真机/App 使用电脑局域网 IP，不能用 127.0.0.1。
# VITE_SERVER_BASEURL = 'https://your-api.example.com'
# VITE_APP_PROXY_ENABLE = true

# 仅构建工具读取；上传私钥、AppSecret 不可放在 VITE_ 变量里。
# WECHAT_DEVTOOLS_CLI_PATH = '/Applications/wechatwebdevtools.app/Contents/MacOS/cli'

# OPENAPI_SCHEMA_URL = 'https://your-api.example.com/openapi.json'
